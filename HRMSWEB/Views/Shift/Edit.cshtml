@model HRMSWEB.Models.UpdateShiftViewModel

@{
    ViewData["Title"] = "Edit Shift";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Edit Shift
            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ShiftName"></label>

                        <input asp-for="ShiftName"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="GraceMinutes"></label>

                        <input asp-for="GraceMinutes"
                               type="number"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="StartTime"></label>

                        <input asp-for="StartTime"
                               type="time"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="EndTime"></label>

                        <input asp-for="EndTime"
                               type="time"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="HalfDayTime"></label>

                        <input asp-for="HalfDayTime"
                               type="time"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3 d-flex align-items-center">

                        <div class="form-check mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                Active

                            </label>

                        </div>

                    </div>

                </div>

                <button class="btn btn-success">

                    Update

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}