@model List<HRMSWEB.Models.DesignationViewModel>

<h2>Designation List</h2>

<a asp-action="Create"
   class="btn btn-primary">
    Add Designation
</a>

<br />
<br />

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Designation</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Title</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>