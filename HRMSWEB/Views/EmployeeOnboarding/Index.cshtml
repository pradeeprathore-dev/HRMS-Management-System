@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("Role");
}

@model List<HRMSWEB.Models.EmployeeOnboardingViewModel>

@{
    ViewData["Title"] = "Employee Onboarding";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">

            <i class="bi bi-person-workspace text-primary me-2"></i>

            Employee Onboarding

        </h2>

        <p class="text-muted mb-0">

            Total Records :
            <strong>@Model.Count</strong>

        </p>

    </div>

    @if (role == "1")
    {
        <a asp-action="Create"
           class="btn btn-primary shadow-sm">

            <i class="bi bi-plus-circle-fill me-2"></i>

            Add Onboarding

        </a>
    }

</div>

<br />

<div class="card shadow-sm">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">

                <tr>

                    <th>Employee</th>

                    <th>Joining Date</th>

                    <th>Email</th>

                    <th>Seat</th>

                    <th>Progress</th>

                    <th>Status</th>

                    <th>View</th>

                    @if (role == "1")
                    {
                        <th>Action</th>
                    }

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            @item.EmployeeName

                        </td>

                        <td>

                            @item.JoiningDate.ToString("dd-MMM-yyyy")

                        </td>

                        <td>

                            @item.OfficialEmail

                        </td>

                        <td>

                            @item.SeatNumber

                        </td>

                        <td style="width:220px;">

                            <div class="progress">

                                <div class="progress-bar
                                @(item.Progress==100?"bg-success":"bg-info")"

                                     role="progressbar"

                                     style="width:@(item.Progress)%">

                                    @item.Progress %

                                </div>

                            </div>

                        </td>

                        <td>

                            @if(item.IsCompleted)
                            {
                                <span class="badge bg-success">

                                    Completed

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">

                                    Pending

                                </span>
                            }

                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info">

                                <i class="bi bi-eye-fill"></i>

                            </a>

                        </td>
                        @if (role == "1")
                        {
                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this onboarding record?');">

                                    <i class="bi bi-trash-fill"></i>

                                </a>

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<br />

<div class="row">

    <div class="col-md-3">

        <div class="card border-success shadow-sm">

            <div class="card-body text-center">

                <h5 class="text-success">

                    Completed

                </h5>

                <h3>

                    @Model.Count(x => x.IsCompleted)

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-warning shadow-sm">

            <div class="card-body text-center">

                <h5 class="text-warning">

                    Pending

                </h5>

                <h3>

                    @Model.Count(x => !x.IsCompleted)

                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-primary shadow-sm">

            <div class="card-body text-center">

                <h5 class="text-primary">

                    Total

                </h5>

                <h3>

                    @Model.Count

                </h3>

            </div>

        </div>

    </div>

</div>