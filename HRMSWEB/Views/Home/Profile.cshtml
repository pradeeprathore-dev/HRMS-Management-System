@model HRMSWEB.Models.EmployeeViewModel

<div class="container mt-4">

    <!-- Welcome Card -->

    <div class="card shadow border-0 rounded-4 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-3 text-center">

                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage"
                             width="170"
                             height="170"
                             style="border-radius:50%;
                        object-fit:cover;
                        border:5px solid #0d6efd;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/170"
                             width="170"
                             height="170"
                             style="border-radius:50%;
                        object-fit:cover;
                        border:5px solid #0d6efd;" />
                    }

                </div>

                <div class="col-md-9">

                    <h2 class="fw-bold">
                        Welcome,
                        @Model.FirstName @Model.LastName
                    </h2>

                    <p class="text-muted fs-5">
                        Employee Self Service Portal
                    </p>

                    <hr />

                    <div class="row">

                        <div class="col-md-6 mb-2">

                            <i class="bi bi-envelope-fill text-primary"></i>

                            <strong>Email :</strong>

                            @Model.Email

                        </div>

                        <div class="col-md-6 mb-2">

                            <i class="bi bi-building text-success"></i>

                            <strong>Department :</strong>

                            @Model.Department

                        </div>

                        <div class="col-md-6 mb-2">

                            <i class="bi bi-briefcase-fill text-warning"></i>

                            <strong>Designation :</strong>

                            @Model.Designation

                        </div>

                        <div class="col-md-6 mb-2">

                            <i class="bi bi-cash-stack text-danger"></i>

                            <strong>Salary :</strong>

                            ₹ @Model.Salary

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <h4 class="fw-bold mb-3">

        Quick Actions

    </h4>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-calendar-check-fill display-5 text-success"></i>

                    <h5 class="mt-3">
                        Attendance
                    </h5>

                    <p class="text-muted">
                        View your attendance history.
                    </p>

                    <a asp-controller="Attendance"
                       asp-action="Index"
                       asp-route-employeeId="@Model.Id"
                       class="btn btn-success">

                        Open

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-pencil-square display-5 text-warning"></i>

                    <h5 class="mt-3">
                        Apply Leave
                    </h5>

                    <p class="text-muted">
                        Submit a new leave request.
                    </p>

                    <a asp-controller="Leave"
                       asp-action="Apply"
                       class="btn btn-warning">

                        Apply

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-file-earmark-text-fill display-5 text-primary"></i>

                    <h5 class="mt-3">
                        My Leaves
                    </h5>

                    <p class="text-muted">
                        View all leave requests.
                    </p>

                    <a asp-controller="Leave"
                       asp-action="MyLeaves"
                       asp-route-employeeId="@Model.Id"
                       class="btn btn-primary">

                        Open

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-cash-stack display-5 text-danger"></i>

                    <h5 class="mt-3">
                        Payroll
                    </h5>

                    <p class="text-muted">
                        View your salary history.
                    </p>

                    <a asp-controller="Payroll"
                       asp-action="MyPayrolls"
                       asp-route-employeeId="@Model.Id"
                       class="btn btn-danger">

                        Open

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-bell-fill display-5 text-info"></i>

                    <h5 class="mt-3">
                        Notifications
                    </h5>

                    <p class="text-muted">
                        View latest notifications.
                    </p>

                    <a asp-controller="Notification"
                       asp-action="Index"
                       class="btn btn-info text-white">

                        Open

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .card {
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-6px);
        }

</style>