@model HRMSWEB.DTOs.ResetPasswordDto

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h3>Reset Password</h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="ResetPassword"
                  method="post">

                <div class="mb-3">

                    <label>Email</label>

                    <input asp-for="Email"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label>OTP</label>

                    <input asp-for="OTP"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label>New Password</label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label>Confirm Password</label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control" />

                </div>

                <button class="btn btn-success">
                    Reset Password
                </button>

            </form>

        </div>

    </div>

</div>