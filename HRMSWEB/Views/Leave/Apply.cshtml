@model HRMSWEB.Models.LeaveRequestViewModel

@using Microsoft.AspNetCore.Http

@{
    var employeeId =
        Context.Session.GetInt32("EmployeeId");
}

<h2>Apply Leave</h2>
<p>@ViewBag.TestJson</p>

<form method="post">

    <!-- HIDDEN EMPLOYEE ID -->

    <input asp-for="EmployeeId"
           type="hidden"
           value="@employeeId" />

    <div class="mb-3">

        <label>Leave Type</label>

        <select asp-for="LeaveTypeId"
                asp-items="Model.LeaveTypes"
                class="form-control">

            <option value="">
                Select Leave Type
            </option>

        </select>

    </div>

    <div class="mb-3">

        <label>Start Date</label>

        <input asp-for="StartDate"
               type="date"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>End Date</label>

        <input asp-for="EndDate"
               type="date"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>Reason</label>

        <textarea asp-for="Reason"
                  class="form-control">
        </textarea>

    </div>

    <button type="submit"
            class="btn btn-primary">

        Apply Leave

    </button>

</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">

        @ViewBag.Error

    </div>
}