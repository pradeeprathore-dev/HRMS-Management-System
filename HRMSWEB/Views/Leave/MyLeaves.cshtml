@model List<HRMSWEB.Models.LeaveResponseViewModel>

<h2>My Leaves</h2>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Id</th>
            <th>Employee</th>
            <th>Leave Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var leave in Model)
        {
            <tr>

                <td>@leave.Id</td>

                <td>@leave.EmployeeName</td>

                <td>@leave.LeaveType</td>

                <td>@leave.StartDate.ToShortDateString()</td>

                <td>@leave.EndDate.ToShortDateString()</td>

                <td>@leave.Reason</td>

                <td>@leave.Status</td>

            </tr>
        }

    </tbody>

</table>