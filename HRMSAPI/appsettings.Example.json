{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DBCS": "YOUR_SQL_SERVER_CONNECTION_STRING"
  },

  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY",
    "Issuer": "HRMSAPI",
    "Audience": "HRMSUSER"
  },

  "MailSettings": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Mail": "YOUR_EMAIL",
    "Username": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD"
  }
}